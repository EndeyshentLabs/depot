include "../std/defs.dpt"
include "../std/c.dpt"

const ITERATION_COUNT 30 ;

const sizeof(tape) 40 sizeof(bool) * ;
memory tape sizeof(tape) ;
memory next-tape sizeof(tape) ;

proc lnot bool -- bool { >cast: int64 0 = }
proc lor bool bool -- bool { >cast: int64 swap >cast: int64 + >cast: bool }
proc land bool bool -- bool { >cast: int64 swap >cast: int64 * >cast: bool }

proc min int64 int64 -- int64 { over over < if drop else swap drop then }

memory ?alive/index sizeof(int64) ;
proc ?alive int64 -- bool {
    ?alive/index !64

    tape ?alive/index @64 1 - ptr+ @8 4 *
    tape ?alive/index @64     ptr+ @8 2 *
    tape ?alive/index @64 1 + ptr+ @8
    + +

    dup 0 = over 4 = rot 7 = lor lor lnot
}

proc iteration {
    sizeof(tape) 1 -
    1 while over over > {
        dup ?alive >cast: int64
        over next-tape ptr+ !8
        1 +
    } drop drop

    sizeof(tape) 1 -
    0 while over over > {
        dup next-tape ptr+ @8 over tape ptr+ !8
        1 +
    } drop drop
}

proc print-tape {
    sizeof(tape)
    0 while over over > {
        dup tape ptr+ @8 >cast: bool if
            35 putchar
        else
            32 putchar
        then
        1 +
    } drop drop
    10 putchar
}

proc main -- int64 {
    1 tape sizeof(tape) 1 - ptr+ !8
    print-tape
    0 while dup ITERATION_COUNT < {
        iteration
        print-tape
        1 +
    } drop
    0
}
