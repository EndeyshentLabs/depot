include "../std/posix.dpt"
include "../std/format.dpt"

proc main -- int64 {
    1 while dup 100 <= {
        dup 15 mod 0 = if
            "FizzBuzz" print
        else dup 3 mod 0 = elif
            "Fizz" print
        else dup 5 mod 0 = elif
            "Buzz" print
        else
            dup print
        then
        "\n" print

        1 +
    }
    drop
    0
}
