link "c"

extern proc puts ptr -- ;
extern proc putchar int64 -- ;
extern proc printf ptr int64 -- ; // NOTE: add `poly` type

proc >cstr int64 ptr -- ptr { swap drop }

proc print int64 ptr -- { >cstr puts }
proc printn int64 -- { "%d" >cstr swap printf }

proc main -- int64 {
    1 while dup 100 <= {
        dup 15 mod 0 = if
            "FizzBuzz" print
        else dup 3 mod 0 = elif
            "Fizz" print
        else dup 5 mod 0 = elif
            "Buzz" print
        else
            dup printn 10 putchar
        then

        1 +
    }
    drop
    0
}
