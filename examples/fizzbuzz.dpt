link "c"

extern proc puts ptr -- ;
extern proc putchar int64 -- ;
extern proc printf ptr int64 -- ; // NOTE: add `poly` type

proc >cstr {
    swap drop
}

proc print {
    >cstr puts
}

proc printn {
    "%d" >cstr swap printf
}

proc main {
    1 while dup 100 <= {
        dup 15 mod 0 = if
            "FizzBuzz" print
        else dup 3 mod 0 = elif
            "Fizz" print
        else dup 5 mod 0 = elif
            "Buzz" print
        else
            dup printn 10 putchar
        then

        1 +
    }
    drop
}
